# Copy this file to .env and fill in your key to enable AI meal/photo analysis.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for analysis (defaults to a fast/cheap one)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only needed if you deployed this to a host with no permanent disk (e.g. Render's
# free tier) and want your logged meals to survive redeploys/restarts. Leave both
# blank to just use a local SQLite file (the default). Get these from a free
# database at https://turso.tech
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
